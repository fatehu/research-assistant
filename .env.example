# ===========================================
# 数据库配置
# ===========================================
APP_ENV=development
POSTGRES_USER=research_user
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=research_assistant
DATABASE_URL=postgresql://research_user:change_me_to_a_strong_password@postgres:5432/research_assistant

# ===========================================
# Redis 配置
# ===========================================
REDIS_URL=redis://redis:6379/0

# ===========================================
# JWT 配置
# ===========================================
SECRET_KEY=change_me_to_a_random_string_at_least_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===========================================
# LLM 配置 - 多厂商支持
# ===========================================
# 默认使用的 LLM 提供商: deepseek, openai, aliyun, ollama
DEFAULT_LLM_PROVIDER=deepseek

# DeepSeek 配置 (默认)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI 配置
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# 阿里云通义配置
ALIYUN_API_KEY=your-aliyun-api-key
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIYUN_MODEL=qwen-plus

# Ollama 本地配置 (阶段7)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3

# ===========================================
# 搜索引擎配置 - Serper API (Google 搜索)
# ===========================================
# 获取 API Key: https://serper.dev/
# 每月免费额度: 2500 次搜索
SERPER_API_KEY=your-serper-api-key
TAVILY_API_KEY=
BRAVE_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
GITHUB_TOKEN=

# ===========================================
# ReAct Agent 配置
# ===========================================
# 最大迭代次数 (每次迭代包含: 思考 -> 工具调用 -> 观察结果)
# 建议范围: 3-15, 默认: 10
REACT_MAX_ITERATIONS=10
# 论文阅读模块 Agentic 模式最大迭代次数（可单独高于 REACT_MAX_ITERATIONS）
# 建议范围: 4-20, 默认: 8
LITERATURE_AGENT_MAX_ITERATIONS=8

# Agent 推理温度 (0-1, 越高越随机)
REACT_TEMPERATURE=0.7

# 工具输出在前端显示的最大长度（字符数）
REACT_OUTPUT_MAX_LENGTH=500

# Agent Core 开关
AGENT_FUNCTION_CALLING_ENABLED=true
AGENT_FUNCTION_CALLING_FALLBACK_XML=true
AGENT_PARALLEL_TOOL_CALLS_ENABLED=true
AGENT_PARALLEL_TOOL_CALLS_MAX_CONCURRENCY=4
AGENT_CONTEXT_BUDGET_ENABLED=true
AGENT_CONTEXT_MAX_INPUT_TOKENS=10000
AGENT_CONTEXT_WINDOW_TURNS=8
AGENT_CONTEXT_SUMMARY_TRIGGER_TOKENS=7000
AGENT_PERSIST_STEPS_ENABLED=true
AGENT_LONGTERM_MEMORY_ENABLED=false
AGENT_MEMORY_TOP_K=3
AGENT_MEMORY_RETENTION_DAYS=180
AGENT_MEMORY_MAX_ITEMS_PER_USER_CHANNEL=2000
AGENT_MEMORY_SCAN_LIMIT=200
AGENT_MEMORY_SCOPE_MATCH_BOOST=0.18
AGENT_MEMORY_DEFAULT_CHANNELS=chat,codelab_agent,notebook_agent,literature_agent

# Tool 运行时默认配置
TOOL_DEFAULT_TIMEOUT_SECONDS=20
TOOL_DEFAULT_RETRY_COUNT=1
TOOL_OUTPUT_MAX_TOKENS=1200
TOOL_OUTPUT_TRUNCATE_HEAD_RATIO=0.75
TOOL_SELECTION_ENABLED=true
TOOL_SELECTION_FALLBACK_TOOLS=datetime,calculator

# Web 抓取合规配置
WEB_SCRAPE_ENFORCE_ROBOTS=true
WEB_SCRAPE_DOMAIN_MIN_INTERVAL_SECONDS=1.5

# ===========================================
# MCP 配置（Phase 1）
# ===========================================
# 是否启用 MCP 远程工具
MCP_ENABLED=false

# MCP 工具名前缀（最终工具名: mcp.<server>.<tool>）
MCP_TOOL_PREFIX=mcp

# MCP 工具调用超时（秒）
MCP_CALL_TIMEOUT_SECONDS=20

# 可选：MCP 配置文件路径（前端 MCP 配置 UI 会写入此文件）
MCP_CONFIG_PATH=mcp_servers.json

# MCP Server 列表（JSON 数组）
# 示例:
# MCP_SERVERS=[{"name":"fetch","transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-fetch"]}]
MCP_SERVERS=[]

# MCP Tool 路由（JSON 对象）：local_tool -> [remote_tool...]
# 作用：优先走外部 MCP，失败自动回退本地 tool
# 示例:
# MCP_TOOL_ROUTES={"web_search":["mcp.brave.search","mcp.exa.search"],"web_scrape":["mcp.firecrawl.scrape"]}
MCP_TOOL_ROUTES={}

# MCP 双路策略参数（超时/重试/熔断）
MCP_ROUTE_TIMEOUT_SECONDS=15
MCP_ROUTE_RETRY_ATTEMPTS=2
MCP_ROUTE_RETRY_BACKOFF_SECONDS=0.5
MCP_ROUTE_CIRCUIT_BREAKER_FAILURES=3
MCP_ROUTE_CIRCUIT_BREAKER_OPEN_SECONDS=120

# ===========================================
# API 限流配置
# ===========================================
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_STORAGE=auto
API_RATE_LIMIT_REDIS_URL=
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_AUTH_PER_MINUTE=20
API_RATE_LIMIT_CHAT_PER_MINUTE=60
API_RATE_LIMIT_KNOWLEDGE_PER_MINUTE=120
API_RATE_LIMIT_CODELAB_PER_MINUTE=30

# ===========================================
# CodeLab Runner 配置（沙箱执行）
# ===========================================
CODELAB_RUNNER_ENABLED=true
CODELAB_RUNNER_URL=http://codelab-runner:8099
CODELAB_RUNNER_TOKEN=change_me_internal_runner_token
CODELAB_RUNNER_TIMEOUT_SECONDS=25
CODELAB_RUNNER_CONNECT_TIMEOUT_SECONDS=3

# 内部 MCP Web/Literature Server（docker profile: mcp）
MCP_WEB_HOST=0.0.0.0
MCP_WEB_PORT=8091
MCP_WEB_TRANSPORT=streamable-http
MCP_LITERATURE_HOST=0.0.0.0
MCP_LITERATURE_PORT=8092
MCP_LITERATURE_TRANSPORT=streamable-http

# ===========================================
# LLM 推理参数
# ===========================================
# LLM 默认温度 (0-1, 越高越随机)
LLM_TEMPERATURE=0.7

# LLM 最大输出 tokens
LLM_MAX_TOKENS=4096

# ===========================================
# 代码执行配置 (CodeLab)
# ===========================================
# 单次代码执行超时（秒）
CODE_EXECUTION_TIMEOUT=30

# 内核空闲超时（秒），超过此时间的不活跃内核将被自动销毁
# 默认 7200 秒 = 2 小时
KERNEL_IDLE_TIMEOUT=7200

# CodeLab 沙箱执行开关（生产建议开启）
CODELAB_SANDBOX_ENABLED=true
# CodeLab 硬超时（秒，超过会强制终止子进程）
CODELAB_EXEC_TIMEOUT_HARD_SECONDS=20
# CodeLab 单用户并发上限
CODELAB_MAX_CONCURRENCY_PER_USER=2
# 直接执行端点 /api/codelab/execute 开关（默认关闭）
CODELAB_DIRECT_EXECUTE_ENABLED=false

# ===========================================
# Notebook 上下文配置
# ===========================================
# 这些参数控制 Agent 获取的 Notebook 上下文范围
# 调整这些值可以平衡上下文信息量和 token 消耗

# Agent 上下文包含的最近 Cell 数量
NOTEBOOK_CONTEXT_CELLS=5

# 单个 Cell 代码预览的最大字符数
NOTEBOOK_CONTEXT_CELL_MAX_LENGTH=200

# Agent 上下文包含的最大变量数量
NOTEBOOK_CONTEXT_VARIABLES=15

# recent_outputs 包含的 Cell 数量
NOTEBOOK_CONTEXT_OUTPUT_CELLS=5

# ===========================================
# Embedding 配置
# ===========================================
# 支持的 provider: local / aliyun / openai / ollama
# 推荐使用 local (本地模型), 科研场景效果更好且无需 API 费用
EMBEDDING_PROVIDER=local
# Docker backend torch wheel source (CPU default; set cu121 for NVIDIA GPU image)
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
# Docker build pip source (国内网络建议镜像源，避免偶发 SSL/中断)
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# Used by docker-compose.gpu.yml (requires NVIDIA Container Toolkit)
DOCKER_BACKEND_GPUS=all
# 容器统一 UTF-8 运行时（避免日志/中文文本乱码）
CONTAINER_LANG=C.UTF-8
CONTAINER_LC_ALL=C.UTF-8
CONTAINER_PYTHONUTF8=1
CONTAINER_PYTHONIOENCODING=UTF-8

# --- 本地嵌入模型 (推荐) ---
# 推荐科研模型:
#   BAAI/bge-m3              - 多语言SOTA, 1024维, 支持中英文 (默认推荐)
#   allenai/specter2         - Allen AI 科研论文专用, 768维, 仅英文
#   BAAI/bge-large-zh-v1.5   - 中文优化, 1024维
#   nomic-ai/nomic-embed-text-v1.5 - 轻量级, 768维
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
# LOCAL_EMBEDDING_DEVICE: auto / cpu / cuda / mps
LOCAL_EMBEDDING_DEVICE=auto
# LOCAL_EMBEDDING_BATCH_SIZE: 批量推理大小
LOCAL_EMBEDDING_BATCH_SIZE=32
# LOCAL_EMBEDDING_MAX_LENGTH: 最大输入 token 数
LOCAL_EMBEDDING_MAX_LENGTH=8192
# Hugging Face 镜像端点（容器网络受限时可改为可访问镜像）
HF_ENDPOINT=https://hf-mirror.com
# LOCAL_EMBEDDING_CACHE_DIR: 模型缓存目录, 为空使用默认
LOCAL_EMBEDDING_CACHE_DIR=
# LOCAL_EMBEDDING_NORMALIZE: L2 归一化
LOCAL_EMBEDDING_NORMALIZE=true
# LOCAL_EMBEDDING_DIMENSION: 0=模型默认维度, >0 则截断 (Matryoshka)
LOCAL_EMBEDDING_DIMENSION=0
EMBEDDING_DIMENSION_POLICY=adaptive
EMBEDDING_DIM_SMALL=256
EMBEDDING_DIM_MEDIUM=512
EMBEDDING_DIM_SMALL_MAX_CHUNKS=2000
EMBEDDING_DIM_MEDIUM_MAX_CHUNKS=10000
EMBEDDING_DIM_HYSTERESIS_ENABLED=true
EMBEDDING_DIM_HYSTERESIS_SMALL_UP=2500
EMBEDDING_DIM_HYSTERESIS_SMALL_DOWN=1500
EMBEDDING_DIM_HYSTERESIS_MEDIUM_UP=12000
EMBEDDING_DIM_HYSTERESIS_MEDIUM_DOWN=8000
EMBEDDING_DIM_REBUILD_ASYNC=true

# --- Reranker 配置 ---
ENABLE_RERANKER=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RERANKER_DEVICE: auto / cpu / cuda / mps
RERANKER_DEVICE=auto
# RERANKER_TOP_K: pgvector 粗排候选数
RERANKER_TOP_K=20

# --- 混合检索配置 ---
ENABLE_HYBRID_RETRIEVAL=true
HYBRID_VECTOR_TOP_K=20
HYBRID_TEXT_TOP_K=20
HYBRID_RRF_K=60
PGVECTOR_HNSW_EF_SEARCH=40
PGVECTOR_HNSW_EF_SEARCH_MODE=adaptive
PGVECTOR_HNSW_EF_SEARCH_MIN=32
PGVECTOR_HNSW_EF_SEARCH_MAX=96
AGENT_KNOWLEDGE_SCORE_THRESHOLD=0.5
SEARCH_TIMEOUT_PRIMARY_MS=300000
SEARCH_TIMEOUT_FALLBACK_MS=90000
SEARCH_TIMEOUT_AUTO_FALLBACK=true

# --- Query Rewrite 配置 ---
ENABLE_QUERY_REWRITE=true
QUERY_REWRITE_STRATEGIES=synonym,hyde,decompose
QUERY_REWRITE_MAX_SYNONYMS=3
QUERY_REWRITE_MAX_SUBQUERIES=3
QUERY_REWRITE_MAX_VARIANTS=8
QUERY_REWRITE_HYDE_MAX_CHARS=240
QUERY_REWRITE_TIMEOUT_SECONDS=12
QUERY_REWRITE_TEMPERATURE=0.2
QUERY_REWRITE_CACHE_SIZE=2000
QUERY_REWRITE_CACHE_TTL_SECONDS=1800
QUERY_REWRITE_SKIP_SHORT_CHARS=10

# --- Contextual Compression 配置 ---
ENABLE_CONTEXTUAL_COMPRESSION=true
CONTEXTUAL_COMPRESSION_MODE=batch
CONTEXTUAL_COMPRESSION_TIMEOUT_SECONDS=12
CONTEXTUAL_COMPRESSION_TEMPERATURE=0.0
CONTEXTUAL_COMPRESSION_MIN_RELEVANCE=4.0
CONTEXTUAL_COMPRESSION_MAX_CHARS_PER_CHUNK=2200
CONTEXTUAL_COMPRESSION_MAX_OUTPUT_TOKENS=400
CONTEXTUAL_COMPRESSION_MAX_CONCURRENCY=3
CONTEXTUAL_COMPRESSION_BATCH_MAX_CHUNKS=8
CONTEXTUAL_COMPRESSION_SKIP_RERANK_THRESHOLD=0.82
CONTEXTUAL_COMPRESSION_BATCH_RETRY_ATTEMPTS=2
DOCUMENT_PROCESSING_STALE_TIMEOUT_SECONDS=7200

# --- 阿里云 DashScope (备选) ---
# 获取 API Key: https://dashscope.console.aliyun.com/apiKey
ALIYUN_EMBEDDING_API_KEY=your-aliyun-api-key
ALIYUN_EMBEDDING_MODEL=text-embedding-v2

# ===========================================
# 前端配置
# ===========================================
# Docker Compose 默认后端映射端口为 8888
VITE_API_BASE_URL=http://localhost:8888
VITE_WS_BASE_URL=ws://localhost:8888
VITE_SHOW_RAG_METRICS=false
# Docker Desktop + Windows 下热更新不稳定时，建议开启轮询监听
VITE_DEV_WATCH_POLLING=true
VITE_DEV_WATCH_POLLING_INTERVAL=300
CHOKIDAR_USEPOLLING=true
CHOKIDAR_INTERVAL=300

# ===========================================
# 应用配置
# ===========================================
APP_NAME=AI科研助手
APP_VERSION=1.0.0
DEBUG=true
SQLALCHEMY_ECHO=false
# CORS 白名单（逗号分隔，禁止与 allow_credentials 同时配置 *）
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 启动时是否自动建表（生产环境建议 false，改用 Alembic）
AUTO_CREATE_TABLES=false

# ===========================================
# PDF Layout 解析（可选，推荐）
# ===========================================
# auto / markitdown / docling / none
PDF_LAYOUT_PARSER=document_mind
# layout 解析结果至少需要的字符数，低于该值会回退到 pypdf/pdfplumber
PDF_LAYOUT_MIN_CHARS=200

# ===========================================
# Reader Generative UI (Layout Plan V2)
# ===========================================
READER_LAYOUT_PLAN_V2_ENABLED=true
READER_LAYOUT_PLAN_V2_ALLOWLIST=
READER_PIPELINE_MODE=single_agent_v2
READER_PIPELINE_ALLOWLIST_PAPERS=
READER_PIPELINE_ALLOWLIST_PAGES=
READER_SIMPLIFIED_PIPELINE_ENABLED=false
READER_SIMPLIFIED_ALLOWLIST_PAPERS=
READER_SIMPLIFIED_ALLOWLIST_PAGES=
READER_PIPELINE_VERSION=simplified_v2
READER_AGENT_MODEL=qwen3.5-plus
READER_AGENT_TIMEOUT_MS=180000
READER_AGENT_MAX_TOKENS=7000
READER_AGENT_MAX_STEPS=12
READER_AGENT_MAX_REPAIR_ROUNDS=2
READER_CACHE_CLEANUP_ON_STARTUP=false
READER_CACHE_CLEANUP_TIMEOUT_SECONDS=120
READER_CACHE_CLEANUP_SCAN_COUNT=200
READER_PAGE_STRUCTURE_V2_ENABLED=true
READER_POLYGON_HIGHLIGHT_ENABLED=true
READER_AGENT_COMPONENT_STREAM_ENABLED=true
READER_AGENT_TOOLS_ENABLED=true
READER_AGENT_TOOL_WHITELIST=paper_read,knowledge_search
READER_AGENT_ASSEMBLY_TIMEOUT_SECONDS=180
READER_COMPOSE_LAYOUT_LLM_TIMEOUT_SECONDS=120
READER_COMPOSE_LATENCY_BUDGET_MS=600000
READER_COMPOSE_LATENCY_BUDGET_MAX_MS=600000
READER_ANCHOR_MIN_CONFIDENCE=0.78
READER_MM_ASSIST_ENABLED=true
READER_MM_PARSER_MODEL=qwen3-vl-flash
READER_MM_PARSER_FALLBACK_MODEL=qwen-vl-ocr-latest
READER_MM_LAYOUT_MODEL=qwen3.5-plus
READER_MM_PRIMARY_MODEL=qwen3-vl-flash
READER_MM_FALLBACK_MODEL=qwen3-vl-plus
READER_MM_TIMEOUT_MS=90000
READER_MM_PARSER_TIMEOUT_MS=120000
READER_MM_MAX_TOKENS=7000
READER_MM_PARSER_MAX_TOKENS=7000
READER_MM_LINE_CANDIDATE_LIMIT=100
READER_MM_BLOCK_CANDIDATE_LIMIT=72

# ===========================================
# Alibaba Document Mind (optional parser chain)
# ===========================================
# Enable only after filling credentials.
READER_DOCUMENT_MIND_ENABLED=true
# Comma-separated paper ids. Empty means all papers when enabled=true.
READER_DOCUMENT_MIND_ALLOWLIST=
DOCUMENT_MIND_ACCESS_KEY_ID=
DOCUMENT_MIND_ACCESS_KEY_SECRET=
DOCUMENT_MIND_REGION_ID=cn-hangzhou
DOCUMENT_MIND_ENDPOINT=docmind-api.aliyuncs.com
DOCUMENT_MIND_OPTION=docStructure
DOCUMENT_MIND_POLL_INTERVAL_SECONDS=1.5
DOCUMENT_MIND_TIMEOUT_SECONDS=90

# ===========================================
# Chunk Quality Gate (RAG ingestion)
# ===========================================
CHUNK_QUALITY_GATE_ENABLED=false
CHUNK_QUALITY_GATE_MODEL=qwen3.5:0.8b-stable
CHUNK_QUALITY_GATE_TIMEOUT_SECONDS=40
CHUNK_QUALITY_GATE_BAD_THRESHOLD=0.50
CHUNK_QUALITY_GATE_SUSPECT_THRESHOLD=0.65
CHUNK_QUALITY_GATE_NEIGHBOR_WINDOW=1
CHUNK_QUALITY_GATE_MAX_CHUNKS=300
CHUNK_QUALITY_GATE_DOC_FAIL_RATIO=0.55
CHUNK_QUALITY_GATE_FAIL_OPEN=true
CHUNK_QUALITY_GATE_FAIL_ON_UNREPAIRED_BAD=false
CHUNK_REPAIR_ENABLED=true
CHUNK_REPAIR_MAX_ROUNDS=1
CHUNK_REPAIR_MAX_FRAGMENTS=120
CHUNK_REPAIR_MAX_CHARS_PER_CHUNK=1800

# ===========================================
# PDF Line RAG Ingestion
# ===========================================
PDF_RAG_LINE_PIPELINE_ENABLED=true
PDF_RAG_FAIL_OPEN=true
PDF_RAG_QWEN_DEVICE=auto
PDF_RAG_ACTION_MODEL_DIR=tmp/qwen_lora/qwen_action_lora_merged_v1
PDF_RAG_CLEAN_MODEL_DIR=tmp/qwen_lora/qwen_clean_lora_merged_v1
PDF_RAG_CHUNK_MODEL_DIR=tmp/qwen_lora/qwen_chunk_lora_merged_v1
PDF_RAG_OCR_ENABLED=true
PDF_RAG_OCR_MODEL=qwen3.5:0.8b-stable
PDF_RAG_OCR_TIMEOUT_SECONDS=30
PDF_RAG_OCR_DPI=180
PDF_RAG_OCR_PADDING=4.0
